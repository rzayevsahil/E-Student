<UserControl x:Class="DocumentSearch.Views.DocumentSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocumentSearch.ViewModels"
             xmlns:converters="clr-namespace:DocumentSearch.Converters"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    <UserControl.Resources>
        <converters:TagParamConverter x:Key="TagParamConverter"/>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                    <TextBlock Text="🔍" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Doc_Title}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="{DynamicResource Doc_Subtitle}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Command="{Binding LoadFilesCommand}"
                    Margin="0,0,12,0"
                    Padding="14,8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="➕ " FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Doc_UploadButtonText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock Text="{Binding StatusMessage}" 
                       VerticalAlignment="Center" 
                       FontSize="13"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Documents List with Drag & Drop & Filtering -->
            <Border Grid.Column="0" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="6"
                    AllowDrop="True"
                    DragOver="DocumentsBorder_DragOver"
                    Drop="DocumentsBorder_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header with Total Count -->
                    <Grid Grid.Row="0" Background="{DynamicResource CardHeaderBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" 
                                   Text="{DynamicResource Doc_UploadedFiles}" 
                                   FontWeight="Bold" 
                                   Padding="12,10"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding TotalCount, StringFormat='({0})'}" 
                                   FontWeight="SemiBold" 
                                   Padding="0,10,12,10"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </Grid>

                    <!-- Mini Search / Filter Bar for Documents List -->
                    <Border Grid.Row="1" Margin="8,6,8,2" 
                            Background="{DynamicResource InputBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Height="30">
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" 
                                  Data="M 7,2 A 5,5 0 1 0 7,12 A 5,5 0 1 0 7,2 Z M 10.5,10.5 L 15,15" 
                                  Stroke="{DynamicResource SecondaryTextBrush}" 
                                  StrokeThickness="1.8" 
                                  StrokeLineJoin="Round"
                                  StrokeEndLineCap="Round"
                                  Width="12" 
                                  Height="12" 
                                  Stretch="Uniform" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,6,0"/>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Doc_SearchInList}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource SecondaryTextBrush}" 
                                           Opacity="0.5" 
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DocumentFilterText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentFilterText}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding DocumentFilterText, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12"
                                         Background="Transparent"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         CaretBrush="{DynamicResource PrimaryTextBrush}"
                                         BorderThickness="0"
                                         Padding="0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Filter Chips (Mini Filter Buttons) -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="6,4,6,6">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="RadioButton" x:Key="FilterChipStyle">
                                    <Setter Property="Margin" Value="2,0"/>
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="chipBorder" 
                                                        Background="{DynamicResource InputBackgroundBrush}" 
                                                        BorderBrush="{DynamicResource BorderBrush}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="12" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"
                                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="chipBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="chipBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>

                            <RadioButton Style="{StaticResource FilterChipStyle}" 
                                         GroupName="FileFilter" 
                                         IsChecked="True" 
                                         Command="{Binding SelectFilterCommand}" 
                                         CommandParameter="All">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Doc_Filter_All}"/>
                                    <TextBlock Text="{Binding TotalCount, StringFormat=' ({0})'}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FilterChipStyle}" 
                                         GroupName="FileFilter" 
                                         Command="{Binding SelectFilterCommand}" 
                                         CommandParameter="Favorites">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Doc_Filter_Favorites}"/>
                                    <TextBlock Text="{Binding FavoriteCount, StringFormat=' ({0})'}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FilterChipStyle}" 
                                         GroupName="FileFilter" 
                                         Command="{Binding SelectFilterCommand}" 
                                         CommandParameter="Image">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Doc_Filter_Images}"/>
                                    <TextBlock Text="{Binding ImageCount, StringFormat=' ({0})'}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FilterChipStyle}" 
                                         GroupName="FileFilter" 
                                         Command="{Binding SelectFilterCommand}" 
                                         CommandParameter="PDF">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PDF"/>
                                    <TextBlock Text="{Binding PdfCount, StringFormat=' ({0})'}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FilterChipStyle}" 
                                         GroupName="FileFilter" 
                                         Command="{Binding SelectFilterCommand}" 
                                         CommandParameter="Word">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Word"/>
                                    <TextBlock Text="{Binding WordCount, StringFormat=' ({0})'}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FilterChipStyle}" 
                                         GroupName="FileFilter" 
                                         Command="{Binding SelectFilterCommand}" 
                                         CommandParameter="Excel">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Excel"/>
                                    <TextBlock Text="{Binding ExcelCount, StringFormat=' ({0})'}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource FilterChipStyle}" 
                                         GroupName="FileFilter" 
                                         Command="{Binding SelectFilterCommand}" 
                                         CommandParameter="PowerPoint">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PPT"/>
                                    <TextBlock Text="{Binding PptCount, StringFormat=' ({0})'}"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Dinamik Etiket Çip Filtreleri -->
                            <ItemsControl ItemsSource="{Binding AvailableTagFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource FilterChipStyle}" 
                                                     GroupName="FileFilter" 
                                                     Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                     CommandParameter="{Binding FilterParameter}">
                                            <TextBlock Text="{Binding DisplayText}"/>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ListBox and Empty Dropzone -->
                    <Grid Grid.Row="3">
                        <!-- Drag & Drop Dropzone Empty State Placeholder -->
                        <Border Margin="10" 
                                BorderBrush="{DynamicResource BorderBrush}" 
                                BorderThickness="2" 
                                CornerRadius="8" 
                                Background="Transparent"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FilteredDocuments.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Margin="15,25" HorizontalAlignment="Center">
                                <TextBlock Text="📥" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.7"/>
                                <TextBlock Text="{DynamicResource Doc_DropTitle}" 
                                           FontSize="13" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource PrimaryTextBrush}" 
                                           HorizontalAlignment="Center" 
                                           TextAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Doc_DropSubtext}" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource SecondaryTextBrush}" 
                                           HorizontalAlignment="Center" 
                                           TextAlignment="Center" 
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <ListBox ItemsSource="{Binding FilteredDocuments}"
                                 Margin="5"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 MouseDoubleClick="DocumentListBox_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="ToolTip" Value="Çift tıklayarak dosyayı aç"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Border" 
                                                        Background="{TemplateBinding Background}" 
                                                        CornerRadius="6" 
                                                        Padding="8,6"
                                                        Margin="2,2">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Cursor="Hand" Margin="2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Favori Yıldızı -->
                                        <Button Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding .}"
                                                Content="{Binding FavoriteIcon}"
                                                Foreground="{Binding FavoriteBrush}"
                                                FontSize="15"
                                                Width="22"
                                                Height="22"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                ToolTip="Favorilere Ekle / Çıkar"
                                                VerticalAlignment="Top"
                                                Margin="0,2,6,0"/>

                                        <!-- Dosya adı -->
                                        <TextBlock Grid.Column="1" Grid.Row="0"
                                                   Text="{Binding FileName}" 
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Center"/>
                                        
                                        <!-- Dosya Uzantısı Rozeti (File Extension Badge) -->
                                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border HorizontalAlignment="Left"
                                                    CornerRadius="4"
                                                    Padding="6,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".pdf">
                                                                <Setter Property="Background" Value="#DC2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".docx">
                                                                <Setter Property="Background" Value="#2563EB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".doc">
                                                                <Setter Property="Background" Value="#2563EB"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".xlsx">
                                                                <Setter Property="Background" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".xls">
                                                                <Setter Property="Background" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".pptx">
                                                                <Setter Property="Background" Value="#EA580C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".ppt">
                                                                <Setter Property="Background" Value="#EA580C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".png">
                                                                <Setter Property="Background" Value="#8B5CF6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".jpg">
                                                                <Setter Property="Background" Value="#8B5CF6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".jpeg">
                                                                <Setter Property="Background" Value="#8B5CF6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".bmp">
                                                                <Setter Property="Background" Value="#8B5CF6"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding FileExtension}" Value=".tiff">
                                                                <Setter Property="Background" Value="#8B5CF6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding FileExtension}" 
                                                           FontSize="10" 
                                                           FontWeight="Bold" 
                                                           Foreground="White"/>
                                            </Border>
                                         </StackPanel>
                                         <!-- Etiketler Listesi & Etiket Ekleme Alanı -->
                                         <WrapPanel Grid.Column="1" Grid.Row="2" Margin="0,4,0,0" VerticalAlignment="Center">
                                             <!-- Mevcut Etiketler -->
                                             <ItemsControl ItemsSource="{Binding Tags}">
                                                 <ItemsControl.ItemsPanel>
                                                     <ItemsPanelTemplate>
                                                         <WrapPanel Orientation="Horizontal"/>
                                                     </ItemsPanelTemplate>
                                                 </ItemsControl.ItemsPanel>
                                                 <ItemsControl.ItemTemplate>
                                                     <DataTemplate>
                                                         <Border Background="#3B82F6" CornerRadius="4" Padding="6,2" Margin="0,2,4,2">
                                                             <StackPanel Orientation="Horizontal">
                                                                 <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="10" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                 <Button Margin="4,0,0,0" 
                                                                         Background="Transparent" 
                                                                         Foreground="White" 
                                                                         BorderThickness="0" 
                                                                         FontSize="10" 
                                                                         Cursor="Hand"
                                                                         Padding="1,0"
                                                                         ToolTip="Etiketi Sil"
                                                                         Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                                     <Button.CommandParameter>
                                                                         <MultiBinding Converter="{StaticResource TagParamConverter}">
                                                                             <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/>
                                                                             <Binding Path="."/>
                                                                         </MultiBinding>
                                                                     </Button.CommandParameter>
                                                                     <TextBlock Text="✕" FontSize="9" Foreground="White" Opacity="0.8"/>
                                                                 </Button>
                                                             </StackPanel>
                                                         </Border>
                                                     </DataTemplate>
                                                 </ItemsControl.ItemTemplate>
                                             </ItemsControl>

                                             <!-- Küçük Etiket Ekleme Kutusu -->
                                             <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                                 <Border CornerRadius="4" 
                                                         BorderBrush="{DynamicResource BorderBrush}" 
                                                         BorderThickness="1"
                                                         Background="{DynamicResource InputBackgroundBrush}"
                                                         Padding="2,0"
                                                         Height="22"
                                                         Width="100">
                                                     <TextBox Text="{Binding TagInputText, UpdateSourceTrigger=PropertyChanged}"
                                                              FontSize="10"
                                                              Padding="2,1"
                                                              VerticalAlignment="Center"
                                                              Background="Transparent"
                                                              Foreground="{DynamicResource PrimaryTextBrush}"
                                                              CaretBrush="{DynamicResource PrimaryTextBrush}"
                                                              BorderThickness="0"
                                                              ToolTip="{DynamicResource Doc_TagPlaceholder}"/>
                                                 </Border>
                                                 <Button Command="{Binding DataContext.AddTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         CommandParameter="{Binding .}"
                                                         Content="+"
                                                         ToolTip="{DynamicResource Doc_AddTag}"
                                                         FontSize="11"
                                                         FontWeight="Bold"
                                                         Width="22"
                                                         Height="22"
                                                         Margin="3,0,0,0"
                                                         Background="{DynamicResource AccentBrush}"
                                                         Foreground="White"
                                                         BorderThickness="0"
                                                         Cursor="Hand">
                                                     <Button.Template>
                                                         <ControlTemplate TargetType="Button">
                                                             <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                 <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                             </Border>
                                                         </ControlTemplate>
                                                     </Button.Template>
                                                 </Button>
                                             </StackPanel>
                                         </WrapPanel>

                                        <!-- Sağ İkonlar: Göz/Önizleme & Kaldır Butonu -->
                                        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" 
                                                    Orientation="Horizontal" 
                                                    VerticalAlignment="Top"
                                                    Margin="4,2,0,0">
                                            <Path Data="M 12,4.5 C 7,4.5 2.73,7.61 1,12 C 2.73,16.39 7,19.5 12,19.5 C 17,19.5 21.27,16.39 23,12 C 21.27,7.61 17,4.5 12,4.5 Z M 12,17 C 9.24,17 7,14.76 7,12 C 7,9.24 9.24,7 12,7 C 14.76,7 17,9.24 17,12 C 17,14.76 14.76,17 12,17 Z M 12,9 C 10.34,9 9,10.34 9,12 C 9,13.66 10.34,15 12,15 C 13.66,15 15,13.66 15,12 C 15,10.34 13.66,9 12,9 Z" 
                                                  Fill="{DynamicResource SecondaryTextBrush}" 
                                                  Width="14" 
                                                  Height="14" 
                                                  Stretch="Uniform" 
                                                  Margin="0,0,6,0" 
                                                  Opacity="0.75" 
                                                  ToolTip="Çift tıklayarak aç" 
                                                  VerticalAlignment="Center"/>
                                            <Button Content="✕"
                                                    Width="22"
                                                    Height="22"
                                                    Padding="0"
                                                    FontSize="12"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="#EF4444"
                                                    Cursor="Hand"
                                                    Click="RemoveDocument_Click"
                                                    ToolTip="Dosyayı kaldır"
                                                    VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Background="{DynamicResource SplitterBrush}"/>

            <!-- Right Panel - Search and Results + Split-View Reader Panel -->
            <Grid Grid.Column="2" Margin="10,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box and Results DataGrid -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Row="0" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Doc_SearchTitle}" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,6"/>
                            
                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Height="44">
                                <Grid Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" 
                                          Data="M 7,2 A 5,5 0 1 0 7,12 A 5,5 0 1 0 7,2 Z M 10.5,10.5 L 15,15" 
                                          Stroke="{DynamicResource SecondaryTextBrush}" 
                                          StrokeThickness="2" 
                                          StrokeLineJoin="Round"
                                          StrokeEndLineCap="Round"
                                          Width="16" 
                                          Height="16" 
                                          Stretch="Uniform" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,10,0"/>
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Doc_SearchPlaceholder}"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Opacity="0.5"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontSize="14"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 CaretBrush="{DynamicResource PrimaryTextBrush}"
                                                 SelectionBrush="{DynamicResource AccentBrush}"
                                                 BorderThickness="0"
                                                 VerticalAlignment="Center"
                                                 VerticalContentAlignment="Center"
                                                 Padding="0"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Text="{DynamicResource Doc_AutoSearchSubtext}" 
                                       FontSize="11" 
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Results -->
                    <Border Grid.Row="1" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Background="{DynamicResource CardHeaderBackgroundBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,5">
                                    <TextBlock Text="{DynamicResource Doc_SearchResults}" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    <TextBlock Text="{Binding SearchResults.Count, StringFormat=' ({0})'}" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource PrimaryTextBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           FontSize="10"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Padding="10,0,10,10"
                                           FontStyle="Italic">
                                    <Run Text="{DynamicResource Doc_TipHeader}" Foreground="DarkOrange" FontWeight="SemiBold"/>
                                    <Run Text="{DynamicResource Doc_TipText}"/>
                                </TextBlock>
                            </Grid>
                            
                            <DataGrid Grid.Row="1" 
                                      ItemsSource="{Binding SearchResults}"
                                      SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      Background="Transparent"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="0"
                                      Margin="5"
                                      MouseDoubleClick="SearchResultsDataGrid_MouseDoubleClick"
                                      Cursor="Hand">
                                 <DataGrid.ColumnHeaderStyle>
                                     <Style TargetType="DataGridColumnHeader">
                                         <Setter Property="Background" Value="{DynamicResource CardHeaderBackgroundBrush}"/>
                                         <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                         <Setter Property="FontWeight" Value="SemiBold"/>
                                         <Setter Property="Padding" Value="10,8"/>
                                         <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                         <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                     </Style>
                                 </DataGrid.ColumnHeaderStyle>
                                 <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                        <Setter Property="ToolTip">
                                            <Setter.Value>
                                                <TextBlock>
                                                    <Run Text="Tıklayarak önizleyin, çift tıklayarak "/>
                                                    <Run Text="{Binding PageNumber, StringFormat='sayfa {0}'}" FontWeight="Bold"/>
                                                    <Run Text="'den harici açın"/>
                                                </TextBlock>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PageNumber}" Value="0">
                                                <Setter Property="ToolTip" Value="Tıklayarak önizleyin, çift tıklayarak açın"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding DocumentName}" Width="1.2*">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource Doc_Col_File}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding PageNumber, StringFormat='{}{0}'}" Width="60">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource Doc_Col_Page}"/>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PageNumber}" Value="0">
                                                        <Setter Property="Text" Value="-"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Snippet}" Width="2*">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{DynamicResource Doc_Col_Snippet}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Splitter between Results & Preview Side Panel -->
                <GridSplitter Grid.Column="1" 
                              Width="5" 
                              HorizontalAlignment="Stretch" 
                              Background="{DynamicResource SplitterBrush}"
                              Visibility="{Binding IsPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Right Side Panel: Metin İçi Hızlı Önizleme Paneli (Split-View Reader) -->
                <Border Grid.Column="2"
                        Width="380"
                        Margin="6,0,0,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="6"
                        Visibility="{Binding IsPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Snippet / Eşleşen Metin -->
                            <RowDefinition Height="*"/>    <!-- Page Reader Text -->
                            <RowDefinition Height="Auto"/> <!-- Navigation Footer -->
                        </Grid.RowDefinitions>

                        <!-- Preview Header -->
                        <Border Grid.Row="0" 
                                Background="{DynamicResource CardHeaderBackgroundBrush}"
                                CornerRadius="6,6,0,0"
                                Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <!-- File Extension Badge -->
                                        <Border CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#64748B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PreviewFileExtension}" Value=".pdf">
                                                            <Setter Property="Background" Value="#DC2626"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PreviewFileExtension}" Value=".docx">
                                                            <Setter Property="Background" Value="#2563EB"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PreviewFileExtension}" Value=".doc">
                                                            <Setter Property="Background" Value="#2563EB"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PreviewFileExtension}" Value=".xlsx">
                                                            <Setter Property="Background" Value="#16A34A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PreviewFileExtension}" Value=".xls">
                                                            <Setter Property="Background" Value="#16A34A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PreviewFileExtension}" Value=".pptx">
                                                            <Setter Property="Background" Value="#EA580C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding PreviewFileExtension}" Value=".ppt">
                                                            <Setter Property="Background" Value="#EA580C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding PreviewFileExtension}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <TextBlock Text="{Binding PreviewDocumentName}" 
                                                   FontWeight="Bold" 
                                                   FontSize="13"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="200"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                                        <Run Text="📖 Hızlı Önizleme | Sayfa "/>
                                        <Run Text="{Binding PreviewCurrentPage}" FontWeight="Bold"/>
                                        <Run Text=" / "/>
                                        <Run Text="{Binding PreviewTotalPages}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Header Actions: Harici Aç & Kapat -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Doc_Preview_OpenExternal}"
                                            Padding="8,4"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Background="{DynamicResource InputBackgroundBrush}"
                                            Foreground="{DynamicResource PrimaryTextBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Margin="0,0,6,0"
                                            Click="OpenExternalFromPreview_Click"
                                            ToolTip="{DynamicResource Doc_Preview_OpenExternal}"/>
                                    <Button Content="✕"
                                            Width="26"
                                            Height="26"
                                            FontSize="12"
                                            FontWeight="Bold"
                                            Background="Transparent"
                                            Foreground="{DynamicResource SecondaryTextBrush}"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding ClosePreviewCommand}"
                                            ToolTip="{DynamicResource Doc_Preview_Close}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Matched Snippet Box -->
                        <Border Grid.Row="1" 
                                Margin="10,10,10,5"
                                Padding="10,8"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="3,0,0,0"
                                CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Doc_Preview_SnippetTitle}" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource AccentBrush}" 
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding PreviewSnippet}" 
                                           FontSize="12" 
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource PrimaryTextBrush}" 
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Full Page Text Viewer -->
                        <Border Grid.Row="2" Margin="10,5,10,10" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="6" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBox Text="{Binding PreviewPageText}"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         FontSize="12.5"
                                         FontFamily="Segoe UI, Consolas"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Footer Page Navigation Toolbar -->
                        <Border Grid.Row="3" 
                                Background="{DynamicResource CardHeaderBackgroundBrush}"
                                CornerRadius="0,0,6,6"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" 
                                        Content="{DynamicResource Doc_Preview_Prev}" 
                                        Command="{Binding PreviousPreviewPageCommand}"
                                        Padding="8,4"
                                        FontSize="11"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"/>

                                <TextBlock Grid.Column="1" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           FontSize="11" 
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}">
                                    <Run Text="{DynamicResource Doc_Col_Page}"/>
                                    <Run Text=" "/>
                                    <Run Text="{Binding PreviewCurrentPage}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding PreviewTotalPages}"/>
                                </TextBlock>

                                <Button Grid.Column="2" 
                                        Content="{DynamicResource Doc_Preview_Next}" 
                                        Command="{Binding NextPreviewPageCommand}"
                                        Padding="8,4"
                                        FontSize="11"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
