<Window x:Class="DocumentSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DocumentSearch"
        xmlns:vm="clr-namespace:DocumentSearch.ViewModels"
        mc:Ignorable="d"
        Title="E-Student" 
        Height="700" 
        Width="1150"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Menu -->
        <Border Grid.Column="0" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,1,0" 
                Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0">
                    <!-- Logo/Header -->
                    <Border Background="{DynamicResource HeaderBackgroundBrush}" 
                            Padding="15,20,15,15"
                            Margin="0,0,0,10"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <!-- Logo -->
                            <Image x:Name="LogoImage"
                                   Width="85" 
                                   Height="85" 
                                   Margin="0"
                                   Stretch="Uniform"
                                   Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Menu Items -->
                    <StackPanel>
                        <Button Content="{DynamicResource Nav_DocumentSearch}" 
                                Command="{Binding NavigateToDocumentSearchCommand}"
                                Margin="10,5"
                                Padding="15,12"
                                HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMenuItem}" Value="DocumentSearch">
                                            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="{DynamicResource Nav_Pomodoro}" 
                                Command="{Binding NavigateToPomodoroCommand}"
                                Margin="10,5"
                                Padding="15,12"
                                HorizontalContentAlignment="Left">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedMenuItem}" Value="Pomodoro">
                                            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SelectedForegroundBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Tema Değiştirme Butonu (Light/Dark) -->
                        <Button Command="{Binding ToggleThemeCommand}"
                                Margin="10,10,10,5"
                                Padding="15,12"
                                HorizontalContentAlignment="Left">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource Nav_Theme_Dark}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource Nav_Theme_Light}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Dil Seçimi (Language Selector: TR | EN | AZ) -->
                        <Border Margin="10,12,10,5" Padding="0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Nav_Language}" 
                                           FontSize="11" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource SecondaryTextBrush}" 
                                           Margin="4,0,0,6"/>
                                <UniformGrid Columns="3">
                                    <RadioButton Content="TR" 
                                                 GroupName="AppLanguage" 
                                                 IsChecked="{Binding IsTrSelected}" 
                                                 Command="{Binding ChangeLanguageCommand}" 
                                                 CommandParameter="tr" 
                                                 Margin="2,0" 
                                                 Padding="4,6" 
                                                 FontSize="11" 
                                                 FontWeight="Bold"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 HorizontalContentAlignment="Center"
                                                 Cursor="Hand">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="chip" 
                                                                    Background="{DynamicResource InputBackgroundBrush}" 
                                                                    BorderBrush="{DynamicResource BorderBrush}" 
                                                                    BorderThickness="1" 
                                                                    CornerRadius="6" 
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                    <RadioButton Content="EN" 
                                                 GroupName="AppLanguage" 
                                                 IsChecked="{Binding IsEnSelected}" 
                                                 Command="{Binding ChangeLanguageCommand}" 
                                                 CommandParameter="en" 
                                                 Margin="2,0" 
                                                 Padding="4,6" 
                                                 FontSize="11" 
                                                 FontWeight="Bold"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 HorizontalContentAlignment="Center"
                                                 Cursor="Hand">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="chip" 
                                                                    Background="{DynamicResource InputBackgroundBrush}" 
                                                                    BorderBrush="{DynamicResource BorderBrush}" 
                                                                    BorderThickness="1" 
                                                                    CornerRadius="6" 
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                    <RadioButton Content="AZ" 
                                                 GroupName="AppLanguage" 
                                                 IsChecked="{Binding IsAzSelected}" 
                                                 Command="{Binding ChangeLanguageCommand}" 
                                                 CommandParameter="az" 
                                                 Margin="2,0" 
                                                 Padding="4,6" 
                                                 FontSize="11" 
                                                 FontWeight="Bold"
                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                 HorizontalContentAlignment="Center"
                                                 Cursor="Hand">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RadioButton">
                                                            <Border x:Name="chip" 
                                                                    Background="{DynamicResource InputBackgroundBrush}" 
                                                                    BorderBrush="{DynamicResource BorderBrush}" 
                                                                    BorderThickness="1" 
                                                                    CornerRadius="6" 
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </RadioButton.Style>
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Güncelleme Butonu -->
                        <Button Content="{Binding UpdateButtonText}" 
                                Command="{Binding CheckForUpdatesCommand}"
                                Margin="10,15,10,5"
                                Padding="15,12"
                                HorizontalContentAlignment="Left"
                                Foreground="{Binding UpdateButtonForeground}"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Sürüm Bilgisi (Alt Kısım) -->
                <Border Grid.Row="2"
                        Background="{DynamicResource FooterBackgroundBrush}" 
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10,15"
                        Margin="0">
                    <TextBlock Text="{Binding CurrentVersion}" 
                               FontSize="12" 
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Splitter -->
        <GridSplitter Grid.Column="1" 
                      HorizontalAlignment="Stretch" 
                      Background="{DynamicResource SplitterBrush}"/>

        <!-- Content Area -->
        <ContentControl Grid.Column="2" 
                        Grid.Row="0"
                        Content="{Binding CurrentView}"
                        Margin="0"/>

        <!-- Geliştirici Bilgisi (Alt Kısım) -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="{DynamicResource FooterBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,8">
            <TextBlock Text="{DynamicResource Footer_Developer}" 
                       FontSize="12" 
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
