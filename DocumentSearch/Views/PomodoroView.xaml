<UserControl x:Class="DocumentSearch.Views.PomodoroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DocumentSearch.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">

    <UserControl.Resources>
        <FontFamily x:Key="DigitalFont">pack://application:,,,/Assets/Fonts/#DSEG7 Classic</FontFamily>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock FontSize="28" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10">
                <Run Foreground="#FF6B35" Text="🍅"/>
                <Run Foreground="{DynamicResource PrimaryTextBrush}" Text="{DynamicResource Pomo_Title}"/>
            </TextBlock>
            <!-- Active Document Focus Badge -->
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="#FF6B35"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="12,6"
                    HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎯 Odaklanılan Belge: " FontSize="12" FontWeight="Bold" Foreground="#FF6B35"/>
                    <TextBlock Text="{Binding Service.ActiveDocumentName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Timer Display (Exact Dual-Color Glow Ring + Digital LED Clock) -->
        <Grid Grid.Row="1" Width="280" Height="280" HorizontalAlignment="Center" Margin="0,0,0,25">
            <!-- Left Arc (Neon Cyan) -->
            <Path Data="M 140,10 A 130,130 0 0 0 140,270" 
                  Stroke="#00D2FF" 
                  StrokeThickness="7" 
                  StrokeStartLineCap="Round" 
                  StrokeEndLineCap="Round">
                <Path.Effect>
                    <DropShadowEffect Color="#00D2FF" BlurRadius="16" ShadowDepth="0" Opacity="0.95"/>
                </Path.Effect>
            </Path>

            <!-- Right Arc (Neon Orange / Coral) -->
            <Path Data="M 140,10 A 130,130 0 0 1 140,270" 
                  Stroke="#FF6B35" 
                  StrokeThickness="7" 
                  StrokeStartLineCap="Round" 
                  StrokeEndLineCap="Round">
                <Path.Effect>
                    <DropShadowEffect Color="#FF6B35" BlurRadius="16" ShadowDepth="0" Opacity="0.95"/>
                </Path.Effect>
            </Path>

            <!-- Inner Dark Circle -->
            <Border Width="236" Height="236" CornerRadius="118" 
                    Background="#191C22" 
                    BorderBrush="#2A2F38" 
                    BorderThickness="1.5"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CurrentPhase}" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#00D2FF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding TimeDisplay}" 
                               FontSize="54" 
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource DigitalFont}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFFFFF" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock Text="{Binding StatusText}" 
                               FontSize="12" 
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Controls -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,10,0,25">
            <Button Content="{Binding ButtonText}" 
                    Command="{Binding StartPauseCommand}"
                    Padding="28,14"
                    FontSize="16"
                    FontFamily="Segoe UI"
                    FontWeight="SemiBold"
                    Margin="8"
                    Background="#00D2FF"
                    Foreground="#0F172A"
                    BorderThickness="0"
                    Cursor="Hand"
                    MinWidth="160"
                    MinHeight="48"
                    Height="48">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                MinHeight="48"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="contentText"
                                     Text="{TemplateBinding Content}" 
                                     FontFamily="Segoe UI"
                                     FontSize="16"
                                     FontWeight="Bold"
                                     Foreground="#0F172A"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     TextWrapping="NoWrap"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0284C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="{DynamicResource Pomo_Reset}" 
                    Command="{Binding ResetCommand}"
                    Padding="28,14"
                    FontSize="16"
                    FontFamily="Segoe UI"
                    FontWeight="SemiBold"
                    Margin="8"
                    Background="#FF6B35"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    MinWidth="160"
                    MinHeight="48"
                    Height="48">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                MinHeight="48"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="contentText"
                                     Text="{TemplateBinding Content}" 
                                     FontFamily="Segoe UI"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     TextWrapping="NoWrap"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F97316"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EA580C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="{DynamicResource Pomo_Skip}" 
                    Command="{Binding SkipCommand}"
                    Padding="28,14"
                    FontSize="16"
                    FontFamily="Segoe UI"
                    FontWeight="SemiBold"
                    Margin="8"
                    Background="#334155"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    MinWidth="160"
                    MinHeight="48"
                    Height="48">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                MinHeight="48"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="contentText"
                                     Text="{TemplateBinding Content}" 
                                     FontFamily="Segoe UI"
                                     FontSize="16"
                                     FontWeight="SemiBold"
                                     Foreground="White"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     TextWrapping="NoWrap"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Info Section -->
        <Border Grid.Row="3" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="{DynamicResource Pomo_CompletedTitle}" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Margin="0,0,0,8"/>
                    
                    <TextBlock Grid.Row="1" 
                               Text="{Binding CompletedCount, StringFormat='{}{0} Pomodoro'}" 
                               FontSize="22" 
                               FontWeight="Bold"
                               Foreground="#00D2FF"
                               Margin="0,0,0,16"/>

                    <TextBlock Grid.Row="2" 
                               Text="{Binding InfoText}" 
                               FontSize="13" 
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Margin="0,5,0,0"/>

                    <StackPanel Grid.Row="2" 
                                Margin="0,20,0,0"
                                Orientation="Vertical">
                        <TextBlock Text="📊 Belge Bazlı Çalışma Süreleri" 
                                   FontSize="15" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding DocumentStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource InputBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,8"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FileName}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                                <TextBlock Text="⏱️ " FontSize="12"/>
                                                <TextBlock Text="{Binding StudyTimeDisplay}" FontWeight="Bold" Foreground="#10B981"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="2" 
                                Margin="0,35,0,0"
                                Orientation="Vertical">
                        <TextBlock Text="{DynamicResource Pomo_HowItWorks}" 
                                   FontSize="15" 
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource Pomo_Step1}" 
                                   FontSize="13" 
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{DynamicResource Pomo_Step2}" 
                                   FontSize="13" 
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{DynamicResource Pomo_Step3}" 
                                   FontSize="13" 
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="{DynamicResource Pomo_Step4}" 
                                   FontSize="13" 
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
